--- TESTCASE Project Leader
--- HTTP
# @name SetupCompany
POST {{ApiBaseUrl}}/api/companies
Content-Type: application/json

{
  "name": "TeaPie Project Leader Company {{ProjectLeaderSuffix}}",
  "code": "PRC{{ProjectLeaderSuffix}}",
  "leaderId": null
}

###

# @name SetupEmployee
POST {{ApiBaseUrl}}/api/companies/{{SetupCompany.response.body.$.id}}/employees
Content-Type: application/json

{
  "title": "Mr.",
  "firstName": "Project",
  "lastName": "Leader",
  "phone": "+421 900 444 555",
  "email": "project.leader.{{ProjectLeaderSuffix}}@example.com"
}

###

# @name SetupDivision
POST {{ApiBaseUrl}}/api/companies/{{SetupCompany.response.body.$.id}}/divisions
Content-Type: application/json

{
  "name": "TeaPie Project Leader Division {{ProjectLeaderSuffix}}",
  "code": "PRD{{ProjectLeaderSuffix}}"
}

###

# @name CreateProject
POST {{ApiBaseUrl}}/api/divisions/{{SetupDivision.response.body.$.id}}/projects
Content-Type: application/json

{
  "name": "TeaPie Leader Project {{ProjectLeaderSuffix}}",
  "code": "PRP{{ProjectLeaderSuffix}}"
}

###

# @name AssignProjectLeader
PUT {{ApiBaseUrl}}/api/projects/{{CreateProject.response.body.$.id}}/leader/{{SetupEmployee.response.body.$.id}}

###

# @name GetProjectLeader
GET {{ApiBaseUrl}}/api/projects/{{CreateProject.response.body.$.id}}/leader
Accept: application/json

###

# @name RemoveProjectLeader
DELETE {{ApiBaseUrl}}/api/projects/{{CreateProject.response.body.$.id}}/leader

###

# @name DeleteProject
DELETE {{ApiBaseUrl}}/api/projects/{{CreateProject.response.body.$.id}}

###

# @name DeleteDivision
DELETE {{ApiBaseUrl}}/api/divisions/{{SetupDivision.response.body.$.id}}

###

# @name DeleteEmployee
DELETE {{ApiBaseUrl}}/api/employees/{{SetupEmployee.response.body.$.id}}

###

# @name CleanupCompany
DELETE {{ApiBaseUrl}}/api/companies/{{SetupCompany.response.body.$.id}}

--- TEST
tp.SetVariable("ProjectLeaderSuffix", DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString());

tp.Test("Setup company, employee, division and project should be created.", () =>
{
    Equal(201, tp.Responses["SetupCompany"].StatusCode());
    Equal(201, tp.Responses["SetupEmployee"].StatusCode());
    Equal(201, tp.Responses["SetupDivision"].StatusCode());
    Equal(201, tp.Responses["CreateProject"].StatusCode());
});

tp.Test("Assign employee as project leader should return 200.", () =>
{
    Equal(200, tp.Responses["AssignProjectLeader"].StatusCode());
});

tp.Test("Get project leader should return 200.", () =>
{
    Equal(200, tp.Responses["GetProjectLeader"].StatusCode());
});

tp.Test("Project leader should be the setup employee.", async () =>
{
    dynamic company = await tp.Responses["SetupCompany"].GetBodyAsExpandoAsync();
    dynamic employee = await tp.Responses["SetupEmployee"].GetBodyAsExpandoAsync();
    dynamic leader = await tp.Responses["GetProjectLeader"].GetBodyAsExpandoAsync();

    Equal((int)employee.id, (int)leader.id);
    Equal("Mr.", (string)leader.title);
    Equal("Project", (string)leader.firstName);
    Equal("Leader", (string)leader.lastName);
    Equal("+421 900 444 555", (string)leader.phone);
    Equal("project.leader." + tp.GetVariable<string>("ProjectLeaderSuffix") + "@example.com", (string)leader.email);
    Equal((int)company.id, (int)leader.companyId);
});

tp.Test("Remove project leader should return 200 or 204.", () =>
{
    int statusCode = tp.Responses["RemoveProjectLeader"].StatusCode();

    True(statusCode == 200 || statusCode == 204);
});

tp.Test("Delete project should return 204.", () =>
{
    Equal(204, tp.Responses["DeleteProject"].StatusCode());
});

tp.Test("Delete division should return 204.", () =>
{
    Equal(204, tp.Responses["DeleteDivision"].StatusCode());
});

tp.Test("Delete employee should return 204.", () =>
{
    Equal(204, tp.Responses["DeleteEmployee"].StatusCode());
});

tp.Test("Cleanup company should return 204.", () =>
{
    Equal(204, tp.Responses["CleanupCompany"].StatusCode());
});
--- END