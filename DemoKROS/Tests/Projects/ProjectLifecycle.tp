--- TESTCASE Verify Deleted Project
--- HTTP
# @name DeleteProject
DELETE {{ApiBaseUrl}}/api/projects/{{ProjectId}}

###

# @name VerifyDeletedProject
GET {{ApiBaseUrl}}/api/projects/{{ProjectId}}
Accept: application/json

###

# @name CleanupDivision
DELETE {{ApiBaseUrl}}/api/divisions/{{ProjectTestDivisionId}}

###

# @name CleanupEmployee
DELETE {{ApiBaseUrl}}/api/employees/{{ProjectTestEmployeeId}}

###

# @name CleanupCompany
DELETE {{ApiBaseUrl}}/api/companies/{{ProjectTestCompanyId}}

--- TEST
tp.Test("Cleanup delete project should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["DeleteProject"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});

tp.Test("Deleted project should return 404.", () =>
{
    Equal(404, tp.Responses["VerifyDeletedProject"].StatusCode());
});

tp.Test("Cleanup division should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["CleanupDivision"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});

tp.Test("Cleanup employee should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["CleanupEmployee"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});

tp.Test("Cleanup company should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["CleanupCompany"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});
--- END