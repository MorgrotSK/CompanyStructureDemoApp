--- TESTCASE Create Department Missing Name
--- HTTP
# @name SetupCompany
POST {{ApiBaseUrl}}/api/companies
Content-Type: application/json

{
  "name": "TeaPie Department Test Company",
  "code": "DEPTC{{DepartmentTestSuffix}}",
  "leaderId": null
}

###

# @name SetupEmployee
POST {{ApiBaseUrl}}/api/companies/{{SetupCompany.response.body.$.id}}/employees
Content-Type: application/json

{
  "title": "Mr.",
  "firstName": "Department",
  "lastName": "Leader",
  "phone": "+421 900 333 444",
  "email": "department.leader.{{DepartmentTestSuffix}}@example.com"
}

###

# @name SetupDivision
POST {{ApiBaseUrl}}/api/companies/{{SetupCompany.response.body.$.id}}/divisions
Content-Type: application/json

{
  "name": "TeaPie Department Parent Division",
  "code": "DEPTD{{DepartmentTestSuffix}}"
}

###

# @name SetupProject
POST {{ApiBaseUrl}}/api/divisions/{{SetupDivision.response.body.$.id}}/projects
Content-Type: application/json

{
  "name": "TeaPie Department Parent Project",
  "code": "DEPTP{{DepartmentTestSuffix}}"
}

###

# @name CreateDepartmentMissingName
POST {{ApiBaseUrl}}/api/projects/{{SetupProject.response.body.$.id}}/departments
Content-Type: application/json

{
  "code": "MISS{{DepartmentTestSuffix}}"
}

--- TEST
tp.SetVariable("DepartmentTestSuffix", Random.Shared.Next(10, 99).ToString());

tp.Test("Setup company, employee, division and project should be created.", async () =>
{
    Equal(201, tp.Responses["SetupCompany"].StatusCode());
    Equal(201, tp.Responses["SetupEmployee"].StatusCode());
    Equal(201, tp.Responses["SetupDivision"].StatusCode());
    Equal(201, tp.Responses["SetupProject"].StatusCode());

    dynamic companyBody = await tp.Responses["SetupCompany"].GetBodyAsExpandoAsync();
    dynamic employeeBody = await tp.Responses["SetupEmployee"].GetBodyAsExpandoAsync();
    dynamic divisionBody = await tp.Responses["SetupDivision"].GetBodyAsExpandoAsync();
    dynamic projectBody = await tp.Responses["SetupProject"].GetBodyAsExpandoAsync();

    tp.SetVariable("DepartmentTestCompanyId", (int)companyBody.id);
    tp.SetVariable("DepartmentTestEmployeeId", (int)employeeBody.id);
    tp.SetVariable("DepartmentTestDivisionId", (int)divisionBody.id);
    tp.SetVariable("DepartmentTestProjectId", (int)projectBody.id);
});

tp.Test("Create department without name should fail.", () =>
{
    Equal(400, tp.Responses["CreateDepartmentMissingName"].StatusCode());
});
--- END


--- TESTCASE Create Department
--- HTTP
POST {{ApiBaseUrl}}/api/projects/{{DepartmentTestProjectId}}/departments
Content-Type: application/json

{
  "name": "TeaPie Test Department",
  "code": "DEPT{{DepartmentTestSuffix}}"
}

--- TEST
tp.Test("Create department should return 201.", () =>
{
    Equal(201, tp.Response.StatusCode());
});

tp.Test("Created department should have expected values.", async () =>
{
    dynamic body = await tp.Response.GetBodyAsExpandoAsync();

    Equal("TeaPie Test Department", (string)body.name);
    Equal("DEPT" + tp.GetVariable<string>("DepartmentTestSuffix"), (string)body.code);
    True((int)body.id > 0);

    tp.SetVariable("DepartmentId", (int)body.id);
});
--- END


--- TESTCASE Create Department Duplicate Code
--- HTTP
POST {{ApiBaseUrl}}/api/projects/{{DepartmentTestProjectId}}/departments
Content-Type: application/json

{
  "name": "Duplicate Department",
  "code": "DEPT{{DepartmentTestSuffix}}"
}

--- TEST
tp.Test("Create department with duplicate code should fail.", () =>
{
    True(tp.Response.StatusCode() == 400 || tp.Response.StatusCode() == 409);
});
--- END


--- TESTCASE Get Created Department By Id
--- HTTP
GET {{ApiBaseUrl}}/api/departments/{{DepartmentId}}
Accept: application/json

--- TEST
tp.Test("Get department should return 200.", () =>
{
    Equal(200, tp.Response.StatusCode());
});

tp.Test("Fetched department should match created values.", async () =>
{
    dynamic body = await tp.Response.GetBodyAsExpandoAsync();

    Equal(tp.GetVariable<int>("DepartmentId"), (int)body.id);
    Equal("TeaPie Test Department", (string)body.name);
    Equal("DEPT" + tp.GetVariable<string>("DepartmentTestSuffix"), (string)body.code);
});
--- END


--- TESTCASE Assign Employee As Department Leader
--- HTTP
PUT {{ApiBaseUrl}}/api/departments/{{DepartmentId}}/leader/{{DepartmentTestEmployeeId}}

--- TEST
tp.Test("Assign employee as department leader should return 200.", () =>
{
    Equal(200, tp.Response.StatusCode());
});
--- END


--- TESTCASE Verify Employee Assigned As Department Leader
--- HTTP
GET {{ApiBaseUrl}}/api/departments/{{DepartmentId}}/leader
Accept: application/json

--- TEST
tp.Test("Get department leader should return 200.", () =>
{
    Equal(200, tp.Response.StatusCode());
});

tp.Test("Department leader should be the setup employee.", async () =>
{
    dynamic body = await tp.Response.GetBodyAsExpandoAsync();

    Equal(tp.GetVariable<int>("DepartmentTestEmployeeId"), (int)body.id);
    Equal("Department", (string)body.firstName);
    Equal("Leader", (string)body.lastName);
    Equal("department.leader." + tp.GetVariable<string>("DepartmentTestSuffix") + "@example.com", (string)body.email);
    Equal(tp.GetVariable<int>("DepartmentTestCompanyId"), (int)body.companyId);
});
--- END


