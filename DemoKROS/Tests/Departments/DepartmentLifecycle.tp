--- TESTCASE Verify Deleted Department
--- HTTP
# @name DeleteDepartment
DELETE {{ApiBaseUrl}}/api/departments/{{DepartmentId}}

###

# @name VerifyDeletedDepartment
GET {{ApiBaseUrl}}/api/departments/{{DepartmentId}}
Accept: application/json

###

# @name CleanupProject
DELETE {{ApiBaseUrl}}/api/projects/{{DepartmentTestProjectId}}

###

# @name CleanupDivision
DELETE {{ApiBaseUrl}}/api/divisions/{{DepartmentTestDivisionId}}

###

# @name CleanupEmployee
DELETE {{ApiBaseUrl}}/api/employees/{{DepartmentTestEmployeeId}}

###

# @name CleanupCompany
DELETE {{ApiBaseUrl}}/api/companies/{{DepartmentTestCompanyId}}

--- TEST
tp.Test("Cleanup delete department should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["DeleteDepartment"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});

tp.Test("Deleted department should return 404.", () =>
{
    Equal(404, tp.Responses["VerifyDeletedDepartment"].StatusCode());
});

tp.Test("Cleanup project should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["CleanupProject"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});

tp.Test("Cleanup division should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["CleanupDivision"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});

tp.Test("Cleanup employee should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["CleanupEmployee"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});

tp.Test("Cleanup company should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["CleanupCompany"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});
--- END