}

--- TEST
tp.Test("Invalid phone should fail.", () =>
{
    Equal(400, tp.Response.StatusCode());
});
--- END


--- TESTCASE Remove Employee From Company Leader
--- HTTP
DELETE {{ApiBaseUrl}}/api/companies/{{EmployeeTestCompanyId}}/leader

--- TEST
tp.Test("Remove leader should succeed.", () =>
{
    True(tp.Response.StatusCode() == 200 || tp.Response.StatusCode() == 204);
});
--- END


