--- END


--- TESTCASE Verify Deleted Employee
--- HTTP
# @name VerifyDeletedEmployee
GET {{ApiBaseUrl}}/api/employees/{{EmployeeId}}
Accept: application/json

###

# @name CleanupCompany
DELETE {{ApiBaseUrl}}/api/companies/{{EmployeeTestCompanyId}}

--- TEST
tp.Test("Deleted employee should return 404.", () =>
{
    Equal(404, tp.Responses["VerifyDeletedEmployee"].StatusCode());
});

tp.Test("Cleanup company should succeed.", () =>
{
    int statusCode = tp.Responses["CleanupCompany"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});
--- END