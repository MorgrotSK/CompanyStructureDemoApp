--- TESTCASE Create Employee
--- HTTP
# @name SetupCompany
POST {{ApiBaseUrl}}/api/companies
Content-Type: application/json

{
  "name": "TeaPie Employee Test Company",
  "code": "EMPTEST",
  "leaderId": null
}

###

# @name CreateEmployee
POST {{ApiBaseUrl}}/api/companies/{{SetupCompany.response.body.$.id}}/employees
Content-Type: application/json

{
  "title": "Mr.",
  "firstName": "TeaPie",
  "lastName": "Employee",
  "phone": "+421 900 123 456",
  "email": "teapie.employee@example.com"
}

--- TEST
tp.Test("Create employee should return 201.", () =>
{
    Equal(201, tp.Responses["SetupCompany"].StatusCode());
    Equal(201, tp.Responses["CreateEmployee"].StatusCode());
});

tp.Test("Created employee should have expected values.", async () =>
{
    dynamic companyBody = await tp.Responses["SetupCompany"].GetBodyAsExpandoAsync();
    dynamic body = await tp.Responses["CreateEmployee"].GetBodyAsExpandoAsync();

    tp.SetVariable("EmployeeTestCompanyId", (int)companyBody.id);

    Equal("Mr.", (string)body.title);
    Equal("TeaPie", (string)body.firstName);
    Equal("Employee", (string)body.lastName);
    Equal("+421 900 123 456", (string)body.phone);
    Equal("teapie.employee@example.com", (string)body.email);
    Equal(tp.GetVariable<int>("EmployeeTestCompanyId"), (int)body.companyId);
    True((int)body.id > 0);

    tp.SetVariable("EmployeeId", (int)body.id);
});
--- END


--- TESTCASE Get Created Employee By Id
--- HTTP
GET {{ApiBaseUrl}}/api/employees/{{EmployeeId}}
Accept: application/json

--- TEST
tp.Test("Get employee should return 200.", () =>
{
    Equal(200, tp.Response.StatusCode());
});

tp.Test("Fetched employee should match created values.", async () =>
{
    dynamic body = await tp.Response.GetBodyAsExpandoAsync();

    Equal(tp.GetVariable<int>("EmployeeId"), (int)body.id);
    Equal("Mr.", (string)body.title);
    Equal("TeaPie", (string)body.firstName);
    Equal("Employee", (string)body.lastName);
    Equal("+421 900 123 456", (string)body.phone);
    Equal("teapie.employee@example.com", (string)body.email);
    Equal(tp.GetVariable<int>("EmployeeTestCompanyId"), (int)body.companyId);
});
--- END


--- TESTCASE Assign Employee As Company Leader
--- HTTP
PUT {{ApiBaseUrl}}/api/companies/{{EmployeeTestCompanyId}}/leader/{{EmployeeId}}

--- TEST
tp.Test("Assign employee as company leader should return 200.", () =>
{
    Equal(200, tp.Response.StatusCode());
});
--- END


--- TESTCASE Verify Employee Assigned As Company Leader
--- HTTP
GET {{ApiBaseUrl}}/api/companies/{{EmployeeTestCompanyId}}/leader
Accept: application/json

--- TEST
tp.Test("Get company leader should return 200.", () =>
{
    Equal(200, tp.Response.StatusCode());
});

tp.Test("Company leader should be the created employee.", async () =>
{
    dynamic body = await tp.Response.GetBodyAsExpandoAsync();

    Equal(tp.GetVariable<int>("EmployeeId"), (int)body.id);
    Equal("TeaPie", (string)body.firstName);
});
--- END


--- TESTCASE Update Employee
--- HTTP
PATCH {{ApiBaseUrl}}/api/employees/{{EmployeeId}}
Content-Type: application/json

{
  "title": "Ing.",
  "firstName": "Updated",
  "lastName": "Employee",
  "phone": "+421 901 555 777",
  "email": "updated.employee@example.com"
}

--- TEST
tp.Test("Update employee should return 200.", () =>
{
    Equal(200, tp.Response.StatusCode());
});

tp.Test("Updated employee should have updated values.", async () =>
{
    dynamic body = await tp.Response.GetBodyAsExpandoAsync();

    Equal("Ing.", (string)body.title);
    Equal("Updated", (string)body.firstName);
    Equal("+421 901 555 777", (string)body.phone);
    Equal("updated.employee@example.com", (string)body.email);
});
--- END


--- TESTCASE Update Employee With Invalid Email
--- HTTP
PATCH {{ApiBaseUrl}}/api/employees/{{EmployeeId}}
Content-Type: application/json

{
  "email": "invalid-email"
}

--- TEST
tp.Test("Invalid email should fail.", () =>
{
    Equal(400, tp.Response.StatusCode());
});
--- END


--- TESTCASE Update Employee With Invalid Phone
--- HTTP
PATCH {{ApiBaseUrl}}/api/employees/{{EmployeeId}}
Content-Type: application/json

{
