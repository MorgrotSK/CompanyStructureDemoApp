--- TESTCASE Remove Employee From Division Leader
--- HTTP
DELETE {{ApiBaseUrl}}/api/divisions/{{DivisionId}}/leader

--- TEST
tp.Test("Remove division leader should return 200 or 204.", () =>
{
    True(tp.Response.StatusCode() == 200 || tp.Response.StatusCode() == 204);
});
--- END


--- TESTCASE Verify Deleted Division
--- HTTP
# @name DeleteDivision
DELETE {{ApiBaseUrl}}/api/divisions/{{DivisionId}}

###

# @name VerifyDeletedDivision
GET {{ApiBaseUrl}}/api/divisions/{{DivisionId}}
Accept: application/json

###

# @name CleanupEmployee
DELETE {{ApiBaseUrl}}/api/employees/{{DivisionTestEmployeeId}}

###

# @name CleanupCompany
DELETE {{ApiBaseUrl}}/api/companies/{{DivisionTestCompanyId}}

--- TEST
tp.Test("Cleanup delete division should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["DeleteDivision"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});

tp.Test("Deleted division should return 404.", () =>
{
    Equal(404, tp.Responses["VerifyDeletedDivision"].StatusCode());
});

tp.Test("Cleanup employee should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["CleanupEmployee"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});

tp.Test("Cleanup company should return 204 or 404.", () =>
{
    int statusCode = tp.Responses["CleanupCompany"].StatusCode();

    True(statusCode == 204 || statusCode == 404);
});
--- END